# Genetic Explorer Environment Configuration

# OpenAI API Key for genetic analysis
OPENAI_API_KEY=sk-your-openai-api-key-here

# Session Secret (generate a strong random string)
SESSION_SECRET=your-super-secret-session-key-min-32-chars

# Node Environment
NODE_ENV=production

# Database Configuration (SQLite)
DATABASE_URL=./data/genetic_explorer.db

# Uploads Directory
UPLOADS_DIR=./uploads

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Application URL (for email links)
APP_URL=http://localhost:3000

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Provider: 'resend' or 'smtp'
EMAIL_PROVIDER=resend

# Email sender configuration
EMAIL_FROM=noreply@geneticexplorer.com
EMAIL_FROM_NAME=Genetic Explorer
SUPPORT_EMAIL=support@geneticexplorer.com

# Resend Configuration (recommended)
# Get your API key from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# SMTP Configuration (alternative to Resend)
# Only used if EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Optional: Analytics
# POSTHOG_API_KEY=phc_your_key_here
# POSTHOG_HOST=https://app.posthog.com

# ============================================  
# ERROR TRACKING (Sentry)
# ============================================
# Optional: Sentry Error Tracking
# Get DSN from: https://sentry.io or your self-hosted Sentry
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# Optional: Custom Sentry URL for third-party compatible services
# Example: https://sentry.my-company.com (for self-hosted or GlitchTip)
# SENTRY_URL=https://sentry.io

# Optional: Sentry Environment (defaults to NODE_ENV)
# SENTRY_ENVIRONMENT=production

# Optional: Sentry Release (defaults to package version)
# SENTRY_RELEASE=1.0.0

# Optional: Performance Monitoring Sample Rates (0-1)
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Optional: Enable Sentry debug mode in development
# SENTRY_DEBUG=false

# ============================================  
# LOGGING (Axiom)
# ============================================
# Optional: Axiom Logging for centralized logs
# Sign up at: https://axiom.co
AXIOM_TOKEN=xaat-your-axiom-token

# Axiom Dataset name
AXIOM_DATASET=genetic-explorer-logs

# Optional: Custom Axiom URL for third-party compatibility
# AXIOM_URL=https://api.axiom.co

# Optional: Disable console logging in production when Axiom is configured
# (Defaults to keeping console logging enabled)
# DISABLE_CONSOLE_LOGS=false

# Optional: Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# Optional: Feature Flags
# ENABLE_NOTIFICATIONS=true
# ENABLE_SHARING=true
# ENABLE_RESEARCH_UPDATES=true

# ============================================
# SOCIAL LOGIN (OAuth)
# ============================================
# Google OAuth - Get credentials at: https://console.cloud.google.com
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth - Get credentials at: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth callback URL (set this in your OAuth provider settings)
# OAUTH_CALLBACK_URL=https://yourdomain.com/api/auth/oauth/callback

# ============================================
# SIGNUP RESTRICTIONS
# ============================================
# Disable all new account registration (true/false)
# DISABLE_SIGNUP=false

# Disable password-based signup, allow only OAuth (true/false)
# DISABLE_PASSWORD_SIGNUP=false

# Comma-separated list of allowed email domains (empty = all allowed)
# Example: "company.com,edu.org,medical.com"
# ALLOWED_EMAIL_DOMAINS=

# Comma-separated list of blocked email domains
# Example: "tempmail.com,throwaway.org,mailinator.com"
# BLOCKED_EMAIL_DOMAINS=

# Require invite token for signup (true/false)
# INVITE_ONLY=false

# Require email verification before account activation (true/false)
# REQUIRE_EMAIL_VERIFICATION=true

# Maximum signups per IP per day (0 = unlimited)
# SIGNUP_RATE_LIMIT_PER_IP=10

# ============================================
# ENCRYPTION (At-Rest Data Protection)
# ============================================
# IMPORTANT: Generate a strong random key for production!
# Use: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your-32-character-minimum-encryption-key

# ============================================
# CLOUD KMS (Optional - Higher Security)
# ============================================
# If cloud KMS is configured, it takes precedence over ENCRYPTION_MASTER_KEY
# Using envelope encryption for cost efficiency (1 API call per day)

# AWS KMS Configuration
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure Key Vault Configuration
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# AZURE_KEY_NAME=genetic-explorer-key
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# GCP KMS Configuration
# GCP_KMS_KEY_NAME=projects/PROJECT_ID/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# GCP_KMS_LOCATION=us-central1
# GCP_KMS_KEY_RING=genetic-explorer
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ============================================
# VECTOR DATABASE (Zilliz Cloud)
# ============================================
# For semantic search and similarity matching
# Sign up at: https://cloud.zilliz.com
# Free tier: 5GB storage, ~1M vectors
ZILLIZ_ENDPOINT=https://your-cluster-id.cluster.zilliz.com
ZILLIZ_TOKEN=your-zilliz-api-token
