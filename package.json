{
  "name": "genetic-explorer",
  "version": "1.0.0",
  "description": "Open-source genetic data analysis platform with privacy-first design",
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "build:vercel": "DEPLOYMENT_PLATFORM=vercel vinxi build",
    "build:cf": "DEPLOYMENT_PLATFORM=cloudflare vinxi build",
    "build:netlify": "DEPLOYMENT_PLATFORM=netlify vinxi build",
    "build:fly": "DEPLOYMENT_PLATFORM=fly vinxi build",
    "build:railway": "DEPLOYMENT_PLATFORM=railway vinxi build",
    "build:heroku": "DEPLOYMENT_PLATFORM=heroku vinxi build",
    "build:do": "DEPLOYMENT_PLATFORM=digitalocean vinxi build",
    "build:northflank": "DEPLOYMENT_PLATFORM=northflank vinxi build",
    "start": "vinxi start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t genetic-explorer .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy:vercel": "vercel --prod",
    "deploy:cf": "wrangler deploy",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:railway": "railway up",
    "deploy:render": "echo 'Deploy via Render dashboard or Git integration'",
    "deploy:fly": "fly deploy",
    "deploy:koyeb": "koyeb service deploy",
    "deploy:heroku": "git push heroku main",
    "deploy:do": "doctl apps create --spec .do/app.yaml",
    "deploy:do-update": "doctl apps update $(doctl apps list --format ID --no-header) --spec .do/app.yaml",
    "deploy:northflank": "echo 'Deploy via Northflank dashboard, Git integration, or use: northflank apply -f northflank.yaml'",
    "fly:launch": "fly launch",
    "railway:login": "railway login",
    "railway:link": "railway link",
    "heroku:create": "heroku create",
    "heroku:push": "git push heroku main",
    "doctl:login": "doctl auth init",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "security:scan": "tsx scripts/security-scan.ts",
    "security:audit": "node scripts/security-audit.js",
    "key:rotate": "tsx scripts/key-rotation.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run"
  },
