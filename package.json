{
  "name": "genetic-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "build:vercel": "cp app.config.vercel.ts app.config.ts && vinxi build",
    "build:cf": "cp app.config.cloudflare.ts app.config.ts && vinxi build",
    "build:netlify": "cp app.config.netlify.ts app.config.ts && vinxi build",
    "build:fly": "cp app.config.fly.ts app.config.ts && vinxi build",
    "build:railway": "cp app.config.railway.ts app.config.ts && vinxi build",
    "build:heroku": "cp app.config.heroku.ts app.config.ts && vinxi build",
    "build:do": "cp app.config.digitalocean.ts app.config.ts && vinxi build",
    "build:northflank": "cp app.config.northflank.ts app.config.ts && vinxi build",
    "start": "vinxi start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t genetic-explorer .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "deploy:vercel": "vercel --prod",
    "deploy:cf": "wrangler deploy",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:railway": "railway up",
    "deploy:render": "echo 'Deploy via Render dashboard or Git integration'",
    "deploy:fly": "fly deploy",
    "deploy:koyeb": "koyeb service deploy",
    "deploy:heroku": "git push heroku main",
    "deploy:do": "doctl apps create --spec .do/app.yaml",
    "deploy:do-update": "doctl apps update $(doctl apps list --format ID --no-header) --spec .do/app.yaml",
    "deploy:northflank": "echo 'Deploy via Northflank dashboard, Git integration, or use: northflank apply -f northflank.yaml'",
    "fly:launch": "fly launch",
    "railway:login": "railway login",
    "railway:link": "railway link",
    "heroku:create": "heroku create",
    "heroku:push": "git push heroku main",
    "doctl:login": "doctl auth init",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.6",
    "@react-email/render": "^2.0.4",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.157.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tanstack/router-devtools": "^1.157.18",
    "@tanstack/router-generator": "1.95.6",
    "@tanstack/router-plugin": "1.95.2",
    "@tanstack/start": "1.91.0",
    "autoprefixer": "^10.4.24",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "entities": "^4.5.0",
    "framer-motion": "^12.29.3",
    "fuse.js": "^7.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "nodemailer": "^7.0.13",
    "openai": "^6.17.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "^5.2.5",
    "recharts": "^3.7.0",
    "resend": "^6.9.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uuid": "^13.0.0",
    "vike": "^0.4.253",
    "vinxi": "^0.5.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18",
    "wrangler": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
