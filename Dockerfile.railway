# Railway-specific Dockerfile
FROM node:20-alpine

# Install build dependencies
RUN apk add --no-cache python3 make g++ sqlite-libs

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* pnpm-lock.yaml* ./

# Install dependencies
RUN if [ -f pnpm-lock.yaml ]; then \
      npm install -g pnpm && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install; \
    fi

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Create data and uploads directories
RUN mkdir -p data uploads/genomes uploads/temp uploads/exports

# Environment
ENV NODE_ENV=production
ENV PORT=${PORT:-3000}
ENV HOST=0.0.0.0

# Railway provides a persistent volume at /data
ENV DATABASE_URL=/data/genetic_explorer.db
ENV UPLOADS_DIR=/app/uploads

# Expose port
EXPOSE ${PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || 3000) + '/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start
CMD ["npm", "start"]
